# The C2 dependency snapshot is generated by a POSIX shell (LF) and compared
# against that generator's output. With core.autocrlf=true and no rule here,
# a fresh Windows checkout produced a CRLF file, so `scripts/check-deps.sh`
# reported "mlmf-core's transitive dependency set changed" — a whole-file
# diff and a false message — on a clean tree, for every developer, forever.
# The prescribed remedy (--bless) wrote LF back, which git re-converted on
# the next checkout, so the false failure returned. Pin it.
crates/mlmf-core/tests/transitive-deps.snapshot text eol=lf

# Shell scripts must keep LF or they do not run under bash at all.
*.sh text eol=lf

# The C3 purity fixture is compared as text by tests/purity.rs.
*.fixture text eol=lf

# The type-geometry fixtures are compared as text. `str::lines()` already
# tolerates CRLF, so this is defence against a future non-Rust consumer
# doing a byte comparison — which is exactly how the snapshot scar above
# happened.
*.tsv text eol=lf

# Licence files are compared byte-for-byte against canonical upstream text
# (Apache-2.0 sha256 cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30).
# Without this, core.autocrlf rewrites them on a Windows checkout and the
# hash stops matching for a reason nobody would guess from the symptom.
LICENSE-* text eol=lf
